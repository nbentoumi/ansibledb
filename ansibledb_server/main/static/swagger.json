securityDefinitions:
   APIKeyHeader:
     type: apiKey
     in: header
     name: token
     description: |
       API token issued from the AnsibleDB Settings page.
       Tokens expire after the configured number of days (default 30).
       Possible 401 responses:
         - {"message": "token required"} – header missing or token not found
         - {"message": "token expired"}  – token found but past its expiry date
definitions:
  Get Hosts and Facters:
    properties:
      hostname:
        type: string
      facter:
        type: string
    type: object
  Get Facters:
    properties:
      fact:
        type: string
    type: object
  Delete hosts:
    properties:
      hostname:
        type: string
    type: object
  AnsibleFacts:
    properties:
      ansible_facts:
        type: object
        description: Full Ansible facts dictionary (must contain a "hostname" key)
    type: object
  AnsibleReport:
    properties:
      ansible_reports:
        type: object
        description: Ansible report object (must contain "hostname" and "report_time" keys)
    type: object
  ErrorResponse:
    properties:
      message:
        type: string
        example: token required
    type: object
  OkResponse:
    properties:
      message:
        type: string
        example: ok
    type: object
info:
  contact:
    email: nasredine.bentoumi@gmail.com
    name: AnsibleDB
  description: AnsibleDB is Flask API server uses MongoDB as Database to store Ansible reports and ansible facts, this tool can be used to query hosts and facters managed Ansible as well search ansible logs.
  license:
    name: Apache 2.0
    url: http://www.apache.org/licenses/LICENSE-2.0.html
  title: AnsibleDB
  version: "1.0"

security:
  - APIKeyHeader: []
paths:
  /api/ansible_facts:
    post:
      summary: Push Ansible facts for a host
      description: Stores or updates Ansible facts for a host. Requires a valid token when the admin has enabled the "require API token" setting.
      operationId: post_ansible_facts
      consumes:
        - application/json
      produces:
        - application/json
      parameters:
        - in: body
          name: body
          required: true
          schema:
            $ref: '#/definitions/AnsibleFacts'
      security:
        - APIKeyHeader: []
      responses:
        200:
          description: Facts stored successfully
          schema:
            $ref: '#/definitions/OkResponse'
        401:
          description: Authentication required or token expired
          schema:
            $ref: '#/definitions/ErrorResponse'
          examples:
            application/json:
              message: token expired
  /api/reports:
    post:
      summary: Push an Ansible playbook report
      description: Stores or updates an Ansible run report. Requires a valid token when the admin has enabled the "require API token" setting.
      operationId: post_ansible_reports
      consumes:
        - application/json
      produces:
        - application/json
      parameters:
        - in: body
          name: body
          required: true
          schema:
            $ref: '#/definitions/AnsibleReport'
      security:
        - APIKeyHeader: []
      responses:
        200:
          description: Report stored successfully
          schema:
            $ref: '#/definitions/OkResponse'
        401:
          description: Authentication required or token expired
          schema:
            $ref: '#/definitions/ErrorResponse'
          examples:
            application/json:
              message: token expired
  /api/servers:
    get:
      consumes:
      - application/json
      operationId: get servers and facters
      parameters:
      - description: Hostname
        in: query
        name: host
        required: false
        type: string
      - description: Facter
        in: query
        name: fact
        required: false
        type: string
      security:
        - APIKeyHeader: []
      responses:
        200:
          description: List of servers / facter values
        401:
          description: Authentication required or token expired
          schema:
            $ref: '#/definitions/ErrorResponse'
          examples:
            application/json:
              message: token expired
      summary: Get Servers and Facters
  /api/facters/{fact}:
    get:
      consumes:
      - application/json
      operationId: get facters
      parameters:
      - description: Facter
        in: path
        name: fact
        required: true
        type: string
      security:
        - APIKeyHeader: []
      responses:
        200:
          description: List of facter values per host
        401:
          description: Authentication required or token expired
          schema:
            $ref: '#/definitions/ErrorResponse'
          examples:
            application/json:
              message: token expired
      summary: Get Facters
  /api/servers/{host}/delete:
    delete:
      consumes:
      - application/json
      operationId: Delete host
      parameters:
      - description: Hostname
        in: path
        name: host
        required: true
        type: string
      security:
        - APIKeyHeader: []
      responses:
        200:
          description: Host deleted
          schema:
            $ref: '#/definitions/OkResponse'
        401:
          description: Authentication required or token expired
          schema:
            $ref: '#/definitions/ErrorResponse'
          examples:
            application/json:
              message: token expired
      summary: Delete a host
swagger: "2.0"
